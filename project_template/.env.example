APP_NAME=chatbot_rag
ENVIRONMENT=local
CORS_ORIGINS=*

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_REQUEST_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_NUM_PREDICT=256
LLM_THINK=false
OLLAMA_KEEP_ALIVE=10m

CHROMA_PATH=./data/vector_store/chroma
CHROMA_COLLECTION=manual_documents
DATABASE_URL=sqlite:///./data/app.sqlite3

RAW_DATA_PATH=./data/raw
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=16
TOP_K=40

TOUR_API_SERVICE_KEY=
TOUR_API_ACCESSIBLE_SERVICE_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_ACCESSIBLE_BASE_URL=https://apis.data.go.kr/B551011/KorWithService2
TOUR_API_HUB_BASE_URL=https://apis.data.go.kr/B551011/LocgoHubTarService1
TOUR_API_RELATED_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
